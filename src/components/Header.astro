<header class="border-b border-line">
  <div class="wrap flex items-center justify-between py-5">
    <a href="#" class="flex items-center gap-2.5 font-display text-[1.15rem] font-bold tracking-tight no-underline text-ink">
      <span class="logo-mark" aria-hidden="true"></span>Sidecar&nbsp;IT
    </a>
    <nav class="flex items-center gap-7">
      <a href="#features" class="hidden text-[0.9rem] text-muted no-underline hover:text-ink sm:inline">What it does</a>
      <a href="#how" class="hidden text-[0.9rem] text-muted no-underline hover:text-ink sm:inline">How it works</a>
      <a href="#pilot" class="btn">Join the pilot</a>
    </nav>
  </div>
</header>

<style>
  .logo-mark {
    display: inline-block;
    width: 22px;
    height: 14px;
    border: 2px solid var(--ink);
    border-radius: 2px;
    position: relative;
  }
  .logo-mark::after {
    content: '';
    position: absolute;
    right: -8px;
    top: 3px;
    width: 5px;
    height: 10px;
    background: var(--accent);
    border-radius: 1px;
  }
</style>
